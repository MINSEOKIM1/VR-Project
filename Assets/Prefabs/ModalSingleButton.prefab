      m_Calls: []
  m_text: "\u2026\uC2DC\uC2A4\uD15C \uC7AC\uAC00\uB3D9 \uC644\uB8CC.\n\uB2F9\uC2E0\uC740
    \uC9C0\uAE08 \uBBF8\uD655\uC778 \uD589\uC131 \uD45C\uBA74\uC5D0 \uCC29\uB959\uD588\uC2B5\uB2C8\uB2E4.
    \uB2F9\uC2E0\uC758 \uC784\uBB34\uB294 \uB2E8\uC21C\uD569\uB2C8\uB2E4. \uC774 
    \uD589\uC131\uC5D0\uC11C \uB9CC\uB098\uB294 \uBAA8\uB4E0 \uAC83\uC744 \uAE30\uB85D\uD558\uACE0,
    \uC0B4\uC544\uC11C \uADC0\uD658\uD558\uC2ED\uC2DC\uC624.\n\uC900\uBE44\uAC00
    \uB418\uBA74 \uC2DC\uC57C \uC911\uC559\uC5D0 \uD45C\uC2DC\uB41C \u2018\uC784\uBB34
    \uC2DC\uC791\u2019\uC744 \uC120\uD0DD\uD558\uC138\uC694.\n"
