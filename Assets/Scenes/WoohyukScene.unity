  m_text: "\u2026\uC2DC\uC2A4\uD15C \uC7AC\uAC00\uB3D9 \uC644\uB8CC.\n\uB2F9\uC2E0\uC740
    \uC9C0\uAE08 \uBBF8\uD655\uC778 \uD589\uC131 \uD45C\uBA74\uC5D0 \uCC29\uB959\uD588\uC2B5\uB2C8\uB2E4.
